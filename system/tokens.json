{
  "color": {
    "brand": {
      "primary": { "$type": "color", "$value": "#1f5fad" },
      "primary-dark": { "$type": "color", "$value": "#164682" }
    },
    "neutral": {
      "900": { "$type": "color", "$value": "#1b1f24" },
      "600": { "$type": "color", "$value": "#56606b" },
      "200": { "$type": "color", "$value": "#dde2e8" },
      "100": { "$type": "color", "$value": "#f3f5f8" },
      "0": { "$type": "color", "$value": "#ffffff" }
    },
    "specialty": {
      "cardiology": { "$type": "color", "$value": "#a52a24" },
      "endocrinology": { "$type": "color", "$value": "#6a3d9a" },
      "respiratory": { "$type": "color", "$value": "#1d6b5a" }
    }
  },
  "text": {
    "default": { "$type": "color", "$value": "{color.neutral.900}" },
    "muted": { "$type": "color", "$value": "{color.neutral.600}" },
    "on-brand": { "$type": "color", "$value": "{color.neutral.0}" }
  },
  "surface": {
    "default": { "$type": "color", "$value": "{color.neutral.0}" },
    "subtle": { "$type": "color", "$value": "{color.neutral.100}" },
    "brand": { "$type": "color", "$value": "{color.brand.primary}" }
  },
  "border": {
    "default": { "$type": "color", "$value": "{color.neutral.200}" }
  },
  "font": {
    "family": {
      "base": { "$type": "fontFamily", "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" }
    },
    "size": {
      "sm": { "$type": "dimension", "$value": "14px" },
      "md": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "20px" },
      "xl": { "$type": "dimension", "$value": "28px" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" }
  }
}
